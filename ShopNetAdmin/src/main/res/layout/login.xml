<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Título grande -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShopNet"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Imagen del logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/icono"
    android:contentDescription="Logo de ShopNet"/>

    <!-- "Botón" de Google Login -->
    <TextView
        android:id="@+id/tvGoogleLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión con Google"
        android:background="@drawable/boton_selector"
        android:textSize="18sp"
        android:padding="12dp"
        android:textColor="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="16dp" />

    <!-- Reseña / descripción -->
    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esta aplicación es la encargada de gestionar los productos de la empresa, permitiendo editarlos, agregarlos y administrar el catálogo completo de e-commerce."
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:padding="15dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />
</LinearLayout>
