<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado PRESIONADO -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_700"/> <!-- Color al presionar -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Estado DESHABILITADO -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/teal_200"/> <!-- Color cuando está deshabilitado -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Estado NORMAL -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_500"/> <!-- Color normal -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

</selector>
